{
  "manifest_version": 3,
  "name": "DOMGuard - Hide Secrets Before You Share or Paste to AI",
  "version": "1.1.1",
  "minimum_chrome_version": "110",
  "description": "Hide API keys, emails and card numbers on any page, then copy a clean screenshot to share or paste into AI tools.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://extensionpay.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["src/extpay/content.ts"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-protect": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Turn Protect all sites on or off"
    },
    "quick-mask": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Mask sensitive data on this page"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture an area of the page"
    }
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
